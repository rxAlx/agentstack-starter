FROM python:3.12-slim

WORKDIR /app

# Install ANP SDK from PyPI + other dependencies
RUN pip install --no-cache-dir \
    anp \
    fastapi \
    uvicorn \
    httpx \
    cryptography \
    pydantic

# Copy only the sidecar code (no local ANP repo needed)
COPY anp/anp-sidecar.py sidecar.py

EXPOSE 8000

CMD ["python", "sidecar.py"]
